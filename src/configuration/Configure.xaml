<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Width="1040" Height="850" MinWidth="720" MinHeight="480" WindowStartupLocation="CenterScreen"
 Background="#F5F8FA" Foreground="#192C35" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="14">
 <Window.Resources>
  <Style x:Key="Segment" TargetType="RadioButton">
   <Setter Property="Height" Value="44"/><Setter Property="Margin" Value="0,0,6,0"/>
   <Setter Property="MinWidth" Value="94"/><Setter Property="Padding" Value="18,0"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
    <Border x:Name="Shell" CornerRadius="22" BorderThickness="1" BorderBrush="#A9BBC4" Background="#FAFCFD" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
     <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
     <Grid>
      <Border x:Name="State" CornerRadius="22" Background="#285C72" Opacity="0" Margin="-17,-1"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
       <TextBlock x:Name="Check" Text="&#x2713;" Margin="0,0,7,0" Visibility="Collapsed" FontWeight="SemiBold"/>
       <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
      </StackPanel>
     </Grid>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True">
      <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
      <Setter Property="Foreground" Value="#103E53"/>
      <Trigger.EnterActions><BeginStoryboard><Storyboard>
       <ColorAnimation Storyboard.TargetName="Shell" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#CEE9F5" Duration="0:0:0.22"/>
      </Storyboard></BeginStoryboard></Trigger.EnterActions>
      <Trigger.ExitActions><BeginStoryboard><Storyboard>
       <ColorAnimation Storyboard.TargetName="Shell" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#FAFCFD" Duration="0:0:0.18"/>
      </Storyboard></BeginStoryboard></Trigger.ExitActions>
     </Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="State" Property="Opacity" Value="0.08"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="#006A8A"/><Setter TargetName="Shell" Property="BorderThickness" Value="2"/></Trigger>
     <Trigger Property="IsPressed" Value="True">
      <Trigger.EnterActions><BeginStoryboard><Storyboard>
       <DoubleAnimation Storyboard.TargetName="Shell" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.96" Duration="0:0:0.10"/>
       <DoubleAnimation Storyboard.TargetName="Shell" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.96" Duration="0:0:0.10"/>
      </Storyboard></BeginStoryboard></Trigger.EnterActions>
      <Trigger.ExitActions><BeginStoryboard><Storyboard>
       <DoubleAnimation Storyboard.TargetName="Shell" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.26"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.18" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
       <DoubleAnimation Storyboard.TargetName="Shell" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.26"/>
      </Storyboard></BeginStoryboard></Trigger.ExitActions>
     </Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Button">
   <Setter Property="Height" Value="46"/><Setter Property="Padding" Value="22,0"/>
   <Setter Property="Background" Value="#E4EDF2"/><Setter Property="Foreground" Value="#244E61"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="ButtonShell" Background="{TemplateBinding Background}" CornerRadius="23" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
     <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
     <Grid><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
      <Border x:Name="Hover" Background="#FFFFFF" CornerRadius="23" Opacity="0" Margin="-21,0"/>
     </Grid>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0.14" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonShell" Property="Opacity" Value="0.80"/><Setter TargetName="ButtonShell" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value></Setter></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonShell" Property="BorderBrush" Value="#006A8A"/><Setter TargetName="ButtonShell" Property="BorderThickness" Value="2"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#FFFFFF"/><Setter Property="CornerRadius" Value="28"/><Setter Property="Padding" Value="24,18"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
  <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="Foreground" Value="#536A75"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
 </Window.Resources>
 <Grid Margin="24,18,24,14">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel x:Name="ContentRoot">
    <StackPanel.RenderTransform><TranslateTransform Y="0"/></StackPanel.RenderTransform>
    <Border CornerRadius="28" Margin="0,0,0,14" Height="148" Background="#172D3A">
     <Grid Margin="28,16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center"><TextBlock Name="Eyebrow" Foreground="#9AC7D9" FontSize="10"/><TextBlock Name="Subtitle" Foreground="#EFF8FC" FontSize="25" Margin="0,12,0,8"/><TextBlock Name="Quality" Foreground="#B5CFDA" FontSize="11" TextWrapping="Wrap"/></StackPanel>
      <Image x:Name="LogoImage" Grid.Column="1" Margin="8,12" Stretch="Uniform"/>
      <Border Grid.Column="2" Background="#2C4655" CornerRadius="14" Padding="12,8" HorizontalAlignment="Right" VerticalAlignment="Top"><TextBlock Foreground="#C4E8F6" FontSize="11" Text="PC EDITION"/></Border>
     </Grid>
    </Border>
    <Border Style="{StaticResource Card}"><StackPanel>
     <TextBlock Name="DisplayTitle" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <TextBlock Name="ResolutionLabel" VerticalAlignment="Center"/><WrapPanel Name="ResolutionChoices" Grid.Column="1"/>
     </Grid>
     <TextBlock Name="ResolutionNote" Style="{StaticResource Hint}" Margin="112,8,0,18"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <TextBlock Name="WindowLabel" VerticalAlignment="Center"/><WrapPanel Name="WindowChoices" Grid.Column="1"/>
     </Grid>
     <StackPanel Name="WindowResolutionPanel" Visibility="Collapsed" Margin="0,14,0,0">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <TextBlock Name="WindowResolutionLabel" VerticalAlignment="Center"/>
       <ComboBox Name="WindowResolutionChoices" Grid.Column="1" Height="38" MinWidth="240" HorizontalAlignment="Left" VerticalContentAlignment="Center" Padding="12,4" FontSize="14"/>
      </Grid>
      <TextBlock Name="WindowResolutionNote" Style="{StaticResource Hint}" Margin="112,8,0,0"/>
     </StackPanel>
     <Border Height="1" Background="#E4EBEF" Margin="0,16,0,14"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <TextBlock Name="FrameLabel" VerticalAlignment="Center"/><WrapPanel Name="FrameChoices" Grid.Column="1"/>
     </Grid>
     <TextBlock Name="FrameNote" Style="{StaticResource Hint}" Margin="112,8,0,0"/>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel>
     <TextBlock Name="InputTitle" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
     <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,20,0"><TextBlock Name="GamepadLabel"/><TextBlock Name="GamepadNote" Style="{StaticResource Hint}" Margin="0,6,0,0"/></StackPanel>
      <WrapPanel Name="GamepadChoices" Grid.Column="1" VerticalAlignment="Center"/>
     </Grid>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,20,0"><TextBlock Name="CameraLabel"/><TextBlock Name="CameraNote" Style="{StaticResource Hint}" Margin="0,6,0,0"/></StackPanel>
      <WrapPanel Name="CameraChoices" Grid.Column="1" VerticalAlignment="Center"/>
     </Grid>
    </StackPanel></Border>
    <TextBlock Name="Pending" Style="{StaticResource Hint}" Margin="12,0,12,16"/>
   </StackPanel>
  </ScrollViewer>
  <Grid Grid.Row="1" Margin="0,10,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Button Name="Defaults" Background="Transparent" FontWeight="Normal"/>
   <Button Name="Verify" Grid.Column="2" Margin="0,0,10,0"/>
   <Button Name="Save" Grid.Column="3" Margin="0,0,10,0"/>
   <Button Name="Play" Grid.Column="4" Background="#255D76" Foreground="#FFFFFF" MinWidth="152"/>
  </Grid>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Border Name="StatusShell" Background="#E5EEF3" CornerRadius="12" Padding="12,8" Margin="0,0,16,0"><TextBlock Name="Status" Style="{StaticResource Hint}"/></Border>
   <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12"><Hyperlink Name="AuthorLink" Foreground="#38657B" TextDecorations="None"/></TextBlock>
  </Grid>
 </Grid>
</Window>
