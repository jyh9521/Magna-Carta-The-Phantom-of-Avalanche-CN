    {
      "id": 193,
      "audio_sha256": "99024b85523edc90c8fa8f8c7d48c3d11e72a6d2c907bb406ea9c1c6e35a14d9",
      "duration_ms": 10542,
      "kind": "speech",
      "cues": [
        {
          "start_ms": 0,
          "end_ms": 1740,
          "source_ko": "안 돼!",
          "target": "不！放手！",
          "state": "translated"
        },
        {
          "start_ms": 2700,
          "end_ms": 4540,
          "source_ko": "내 아기!",
          "target": "我的孩子！",
          "state": "translated"
        },
        {
          "start_ms": 4940,
          "end_ms": 5940,
          "source_ko": "내 아기!",
          "target": "我的孩子！",
          "state": "translated"
        }
      ],
      "existing_translation_reference": "Fpb/0187.fpb:text:3:3",
      "source_crosscheck_ko": "안 돼! 내 아기! 내 아기!"
    },
    {
      "id": 208,
      "audio_sha256": "a1e31620c39d7430e0a1bcb60d9c80f7b8d26e9709c30994d08c5a77b5409718",
